# ============================================================
# TalentFlow AI — environment variables
# Copy to .env.local and fill in. .env* is gitignored: never commit real keys.
# ============================================================

# --- Supabase ---
# Dashboard > Project Settings > Data API  (URL + anon key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dashboard > Project Settings > API Keys > service_role
# Server-side ONLY. It bypasses Row Level Security, so it must never be
# exposed to the browser — do not prefix it with NEXT_PUBLIC_.
# Used by every route in src/app/api/**.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI ---
# Used by all seven AI routes: skill extraction, certification parsing,
# Whisper video transcription, job matching, plan generation, and the
# course / assessment recommenders.
OPENAI_API_KEY=sk-...
